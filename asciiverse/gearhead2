#!/bin/sh
# Starts GearHead 2 from an av install. The game reads its data (gamedata,
# series, design, doc) from the current folder, so this changes into lib/
# first; its settings and saves go to the player's own folder,
# ~/.config/gearhead2 (Windows: the user folder), as upstream has it.
# av links ~/.local/bin/gearhead2 to this file, so follow that link first.
self=$(readlink "$0" 2>/dev/null || printf '%s' "$0")
dir=$(cd "$(dirname "$self")" && pwd)
cd "$dir/lib" && exec ./gearhead2 "$@"
